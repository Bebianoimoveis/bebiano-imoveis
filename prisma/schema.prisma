// Bebiano Imóveis — schema de banco de dados
// Sistema interno single-tenant (sem multi-empresa / sem planos).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Autenticação, papéis e permissões
// ---------------------------------------------------------------------------

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  active       Boolean   @default(true)
  roleId       String
  role         Role      @relation(fields: [roleId], references: [id])
  realtor      Realtor?
  createdLeads Lead[]              @relation("LeadCreatedBy")
  createdProperties Property[]     @relation("PropertyCreatedBy")
  interactions LeadInteraction[]
  clientInteractions ClientInteraction[]
  proposalInteractions ProposalInteraction[]
  financialEntryInteractions FinancialEntryInteraction[]
  activityLogs ActivityLog[]
  notifications Notification[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([roleId])
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique // ADMIN, MANAGER, REALTOR, FINANCIAL
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
}

model Permission {
  id    String           @id @default(cuid())
  key   String           @unique // ex: "property.publish", "financial.view"
  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

// ---------------------------------------------------------------------------
// Corretores e clientes
// ---------------------------------------------------------------------------

model Realtor {
  id        String    @id @default(cuid())
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id])
  phone     String
  photoUrl  String?
  // Posição vertical do enquadramento da foto (0 = topo, 100 = base),
  // ajustada manualmente no cadastro — null usa o padrão (topo), mesmo
  // comportamento de antes de existir esse campo.
  photoPositionY Int?
  creci     String?
  bio       String?
  active    Boolean   @default(true)
  // Identifica o corretor nos links de divulgação (/corretor/joao-silva,
  // ?ref=joao-silva). Gerado automaticamente a partir do nome ao
  // criar/editar o corretor — nullable no banco só pra não exigir
  // backfill obrigatório de corretores antigos numa única migração.
  slug       String?   @unique
  properties Property[]
  leads      Lead[]
  clients    Client[]
  appointments Appointment[]
  proposals    Proposal[]
  contracts    Contract[]
  visitorAttributions VisitorAttribution[]
  defaultForSettings  SiteSettings[]
  financialEntries    FinancialEntry[]
  goals               Goal[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

// Vínculo persistente "este visitante pertence a este corretor" — a fonte
// de verdade por trás do cookie de atribuição. O cookie carrega só o
// `visitorId` (opaco); toda resolução de corretor responsável consulta
// este registro no servidor, nunca confia num valor vindo do cliente.
// Regra de negócio: "primeiro corretor que captou o lead" — uma vez
// criado, só um admin troca o `realtorId` (ver overriddenByUserId).
model VisitorAttribution {
  id        String  @id @default(cuid())
  visitorId String  @unique
  realtorId String
  realtor   Realtor @relation(fields: [realtorId], references: [id])

  // Como esse visitante foi atribuído: "ref:<slug>", "path:/corretor/<slug>",
  // "corretor:<id>", "default" (corretor padrão configurado) ou
  // "round_robin" (fila automática).
  referralSource String
  landingUrl     String
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?

  firstVisitAt DateTime  @default(now())
  lastVisitAt  DateTime  @default(now())
  // firstVisitAt + 30 dias — usado só para o admin saber quando expira;
  // o cookie tem seu próprio maxAge e expira independentemente disso.
  expiresAt    DateTime

  overriddenByUserId String?
  overriddenAt        DateTime?

  leads Lead[]

  createdAt DateTime @default(now())

  @@index([realtorId])
}

enum ClientType {
  BUYER
  SELLER
  TENANT
  INVESTOR
}

enum ClientStatus {
  ACTIVE
  INACTIVE
}

model Client {
  id     String @id @default(cuid())
  code   String @unique // ex: CL-0001
  name   String
  email  String?
  phone  String
  notes  String?

  cpf           String?
  rg            String?
  birthDate     DateTime?
  profession    String?
  maritalStatus String?

  street  String?
  number  String?
  zipCode String?
  cityId  String?
  city    City?   @relation("ClientCity", fields: [cityId], references: [id])

  types  ClientType[] @default([])
  status ClientStatus @default(ACTIVE)
  vip    Boolean      @default(false)
  tags   String[]     @default([])
  // Canal de origem — preenchido automaticamente quando o cliente nasce
  // de um lead convertido (ver convertLeadToClient) ou escolhido
  // manualmente no cadastro. Null quando desconhecido.
  origin String?

  realtorId String?
  realtor   Realtor? @relation(fields: [realtorId], references: [id])

  preference ClientPreference?

  leads        Lead[]
  appointments Appointment[]
  proposals    Proposal[]
  contracts    Contract[]
  interactions ClientInteraction[]
  financialEntries FinancialEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // Atualizado toda vez que uma ClientInteraction é criada — evita
  // recalcular "última interação" juntando várias tabelas a cada listagem
  // (mesmo padrão do Lead.lastInteractionAt).
  lastInteractionAt DateTime  @default(now())
  deletedAt         DateTime?

  @@index([phone])
  @@index([realtorId])
}

// Preferências de busca do cliente — o que ele está procurando. Model
// separado (1:1) em vez de campos soltos no Client porque é um conceito
// próprio (pode não existir ainda pra um cliente recém-cadastrado) e
// mantém o Client enxuto.
model ClientPreference {
  id       String @id @default(cuid())
  clientId String @unique
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  propertyTypeId String?
  propertyType   PropertyType? @relation(fields: [propertyTypeId], references: [id])
  purpose        Purpose?
  minValue       Decimal?      @db.Decimal(12, 2)
  maxValue       Decimal?      @db.Decimal(12, 2)
  cityId         String?
  city           City?         @relation("ClientPreferenceCity", fields: [cityId], references: [id])
  neighborhoodId String?
  neighborhood   Neighborhood? @relation(fields: [neighborhoodId], references: [id])
  bedrooms       Int?
  minArea        Decimal?      @db.Decimal(8, 2)
  pool           Boolean       @default(false)
  gatedCommunity Boolean       @default(false)
  acceptsFinancing Boolean     @default(false)

  updatedAt DateTime @updatedAt
}

// Timeline/notas do cliente registradas diretamente (sem passar por um
// Lead) — espelha LeadInteraction, mas um cliente pode não ter nenhum
// lead vinculado (ex: cadastro manual), então precisa do próprio model.
model ClientInteraction {
  id          String              @id @default(cuid())
  clientId    String
  client      Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId      String
  user        User                @relation(fields: [userId], references: [id])
  type        LeadInteractionType
  description String
  createdAt   DateTime            @default(now())

  @@index([clientId])
}

// ---------------------------------------------------------------------------
// Localização e taxonomias de imóveis
// ---------------------------------------------------------------------------

model City {
  id            String         @id @default(cuid())
  name          String
  state         String
  neighborhoods Neighborhood[]
  properties    Property[]
  clients             Client[]           @relation("ClientCity")
  clientPreferences   ClientPreference[] @relation("ClientPreferenceCity")
  goals               Goal[]
  submissions         PropertySubmission[]

  @@unique([name, state])
}

model Neighborhood {
  id         String     @id @default(cuid())
  name       String
  cityId     String
  city       City       @relation(fields: [cityId], references: [id])
  properties Property[]
  clientPreferences ClientPreference[]

  @@unique([name, cityId])
}

model PropertyType {
  id         String     @id @default(cuid())
  name       String     @unique // Apartamento, Casa, Terreno, Sala Comercial...
  // Desativado = some do site público inteiro (busca, filtros, banners,
  // listagens), não só do menu — permite "guardar" um segmento que a
  // imobiliária ainda não opera (ex: Locação) sem excluir os dados.
  active     Boolean    @default(true)
  properties Property[]
  clientPreferences ClientPreference[]
  segments   Segment[]
  submissions PropertySubmission[]
}

model PropertyFeature {
  id         String                     @id @default(cuid())
  name       String                     @unique // Piscina, Portaria 24h, Churrasqueira...
  properties PropertyFeatureOnProperty[]
}

model PropertyFeatureOnProperty {
  propertyId String
  featureId  String
  property   Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  feature    PropertyFeature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@id([propertyId, featureId])
}

enum Purpose {
  SALE
  RENT
}

enum PropertyStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  RESERVED
  SOLD
  RENTED
  UNAVAILABLE
  ARCHIVED
}

enum AddressVisibility {
  FULL
  APPROXIMATE
  NEIGHBORHOOD_ONLY
}

// ---------------------------------------------------------------------------
// Imóveis
// ---------------------------------------------------------------------------

model Property {
  id          String         @id @default(cuid())
  code        String         @unique // código interno, ex: BB-1024
  title       String
  slug        String         @unique
  description String

  purpose Purpose
  status  PropertyStatus @default(DRAFT)
  featured Boolean       @default(false)

  typeId String
  type   PropertyType @relation(fields: [typeId], references: [id])

  price    Decimal  @db.Decimal(12, 2)
  condoFee Decimal? @db.Decimal(12, 2)
  iptu     Decimal? @db.Decimal(12, 2)

  cityId         String
  city           City          @relation(fields: [cityId], references: [id])
  neighborhoodId String
  neighborhood   Neighborhood  @relation(fields: [neighborhoodId], references: [id])

  addressVisibility AddressVisibility @default(NEIGHBORHOOD_ONLY)
  zipCode           String?
  street            String?
  number            String?
  latitude          Decimal?          @db.Decimal(10, 7)
  longitude         Decimal?          @db.Decimal(10, 7)

  builtArea    Decimal? @db.Decimal(8, 2)
  totalArea    Decimal? @db.Decimal(8, 2)
  // Só usado quando o tipo é Apartamento (empreendimento com várias
  // unidades à venda) — null para os demais tipos.
  availableUnits Int?
  bedrooms     Int      @default(0)
  suites       Int      @default(0)
  bathrooms    Int      @default(0)
  parkingSpots Int      @default(0)

  acceptsFinancing Boolean @default(false)
  acceptsFgts      Boolean @default(false)
  furnished        Boolean @default(false)
  gatedCommunity   Boolean @default(false)

  videoUrl String?

  // "Lançamento" (empreendimento novo) — categoria própria na home
  // pública, distinta de availableUnits (que só indica "apartamento com
  // várias unidades", não necessariamente um lançamento). launchDeliveryAt
  // é a previsão de entrega exibida na seção de Lançamentos; null quando
  // isLaunch é false ou a data ainda não foi definida.
  isLaunch        Boolean   @default(false)
  launchDeliveryAt DateTime?

  // Incrementado a cada acesso à página pública do imóvel — usado no
  // relatório de "imóveis mais visualizados" do dashboard.
  viewCount Int @default(0)

  realtorId String?
  realtor   Realtor? @relation(fields: [realtorId], references: [id])

  createdById String
  createdBy   User   @relation("PropertyCreatedBy", fields: [createdById], references: [id])

  images   PropertyImage[]
  features PropertyFeatureOnProperty[]
  leads    Lead[]
  appointments Appointment[]
  proposals    Proposal[]
  contracts    Contract[]
  financialEntries FinancialEntry[]
  submission   PropertySubmission?

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([status, purpose])
  @@index([cityId, neighborhoodId])
  @@index([featured])
}

model PropertyImage {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  url        String // URL do Cloudinary
  publicId   String // public_id do Cloudinary, necessário para exclusão/transformação
  order      Int      @default(0)
  isCover    Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([propertyId])
}

// ---------------------------------------------------------------------------
// CRM — leads, interações e contatos públicos
// ---------------------------------------------------------------------------

enum LeadStage {
  NEW
  FIRST_CONTACT
  QUALIFIED
  VISIT_SCHEDULED
  PROPOSAL
  NEGOTIATION
  DOCUMENTATION
  CLOSED
  LOST
}

enum LeadTemperature {
  HOT
  WARM
  COLD
}

model Lead {
  id         String    @id @default(cuid())
  name       String
  phone      String
  email      String?
  origin     String // ex: "site", "whatsapp", "indicação"
  stage      LeadStage @default(NEW)
  notes      String?
  nextActionAt DateTime?

  temperature LeadTemperature @default(WARM)
  vip         Boolean         @default(false)
  tags        String[]        @default([])
  // Atualizado toda vez que `stage` muda (inclusive pelo drag-and-drop do
  // Kanban) — é a base de "tempo no estágio" no card, que não existiria
  // sem um timestamp dedicado (não há histórico de transição de estágio).
  stageChangedAt DateTime @default(now())

  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id])

  realtorId String?
  realtor   Realtor? @relation(fields: [realtorId], references: [id])

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id])

  createdById String?
  createdBy   User?   @relation("LeadCreatedBy", fields: [createdById], references: [id])

  // Rastro de origem do formulário que criou este lead — preenchido a
  // partir da VisitorAttribution do visitante no momento da criação.
  // Não reaproveita o campo `origin` (que já tem outro significado:
  // canal do lead, ex: "site"/"whatsapp"/"indicação").
  visitorId      String?
  visitor        VisitorAttribution? @relation(fields: [visitorId], references: [visitorId])
  referralSource String?
  landingUrl     String?
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?

  interactions LeadInteraction[]
  appointments Appointment[]
  proposals    Proposal[]

  createdAt          DateTime  @default(now())
  lastInteractionAt  DateTime  @default(now())
  deletedAt          DateTime?

  @@index([stage])
  @@index([realtorId])
  @@index([propertyId])
  @@index([visitorId])
}

enum LeadInteractionType {
  CALL
  WHATSAPP
  EMAIL
  VISIT
  NOTE
}

model LeadInteraction {
  id          String               @id @default(cuid())
  leadId      String
  lead        Lead                 @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId      String
  user        User                 @relation(fields: [userId], references: [id])
  type        LeadInteractionType
  description String
  createdAt   DateTime             @default(now())

  @@index([leadId])
}

// Registro bruto e imutável de todo formulário público (auditoria/anti-spam).
// Um Lead é criado automaticamente a partir de cada ContactRequest.
model ContactRequest {
  id         String   @id @default(cuid())
  name       String
  phone      String
  email      String?
  message    String?
  propertyId String?
  source     String // ex: "property_page", "contact_page", "hero_search"
  ipAddress  String?
  createdAt  DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Agenda
// ---------------------------------------------------------------------------

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  DONE
  CANCELED
  NO_SHOW
}

enum AppointmentType {
  VISIT
  CALL
  RETURN
  OTHER
}

model Appointment {
  id          String            @id @default(cuid())
  leadId      String?
  lead        Lead?             @relation(fields: [leadId], references: [id])
  clientId    String?
  client      Client?           @relation(fields: [clientId], references: [id])
  propertyId  String?
  property    Property?         @relation(fields: [propertyId], references: [id])
  realtorId   String
  realtor     Realtor           @relation(fields: [realtorId], references: [id])
  scheduledAt DateTime
  // Duração assumida em minutos — não existia campo de fim/duração antes
  // desta entrega; usado pra desenhar blocos na grade de semana/dia e pra
  // detecção de conflito real (janela de sobreposição, não só "por perto").
  durationMinutes Int             @default(60)
  type            AppointmentType @default(VISIT)
  status      AppointmentStatus @default(SCHEDULED)
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([realtorId, scheduledAt])
}

// ---------------------------------------------------------------------------
// Propostas e contratos
// ---------------------------------------------------------------------------

enum ProposalStatus {
  DRAFT
  SENT
  VIEWED
  NEGOTIATING
  ACCEPTED
  REJECTED
  SIGNING
  COMPLETED
  CANCELED
}

model Proposal {
  id         String         @id @default(cuid())
  propertyId String
  property   Property       @relation(fields: [propertyId], references: [id])
  leadId     String?
  lead       Lead?          @relation(fields: [leadId], references: [id])
  clientId   String
  client     Client         @relation(fields: [clientId], references: [id])
  realtorId  String
  realtor    Realtor        @relation(fields: [realtorId], references: [id])
  value      Decimal        @db.Decimal(12, 2)
  status     ProposalStatus @default(DRAFT)
  notes      String?
  contract   Contract?

  // Snapshot do preço anunciado no momento da proposta — não reaproveita
  // property.price porque o preço do imóvel pode mudar depois.
  originalValue     Decimal? @db.Decimal(12, 2)
  downPayment       Decimal? @db.Decimal(12, 2)
  financingValue    Decimal? @db.Decimal(12, 2)
  fgtsValue         Decimal? @db.Decimal(12, 2)
  installments      Int?
  installmentValue  Decimal? @db.Decimal(12, 2)
  commissionPercent Decimal? @db.Decimal(5, 2)
  paymentMethod     String?
  validUntil        DateTime?

  // Link público de acompanhamento (/proposta/[shareToken]) — só leitura,
  // usado pra marcar "cliente visualizou" de verdade (viewedAt) em vez de
  // fingir esse dado.
  shareToken String?   @unique
  sentAt     DateTime?
  viewedAt   DateTime?

  interactions ProposalInteraction[]

  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([propertyId])
}

// Timeline/notas da proposta — espelha ClientInteraction/LeadInteraction,
// reaproveitando o mesmo enum de tipo.
model ProposalInteraction {
  id          String              @id @default(cuid())
  proposalId  String
  proposal    Proposal            @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  userId      String
  user        User                @relation(fields: [userId], references: [id])
  type        LeadInteractionType
  description String
  createdAt   DateTime            @default(now())

  @@index([proposalId])
}

enum ContractStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELED
}

model Contract {
  id         String         @id @default(cuid())
  proposalId String         @unique
  proposal   Proposal       @relation(fields: [proposalId], references: [id])
  propertyId String
  property   Property       @relation(fields: [propertyId], references: [id])
  clientId   String
  client     Client         @relation(fields: [clientId], references: [id])
  realtorId  String
  realtor    Realtor        @relation(fields: [realtorId], references: [id])
  value      Decimal        @db.Decimal(12, 2)
  status     ContractStatus @default(DRAFT)
  fileUrl    String? // contrato assinado, armazenado no Cloudinary (resource_type: raw)
  signedAt   DateTime?
  financialEntries FinancialEntry[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

// ---------------------------------------------------------------------------
// Financeiro
// ---------------------------------------------------------------------------

enum FinancialEntryType {
  INCOME
  EXPENSE
}

// "Atrasado" não existe aqui de propósito: não é um status guardado, é
// PENDING/SCHEDULED cuja dueDate já passou, calculado na hora da leitura
// (sem cron no projeto pra manter um campo "atrasado" atualizado sozinho).
enum FinancialEntryStatus {
  PENDING
  SCHEDULED
  PARTIAL
  PAID
  CANCELED
}

enum PaymentMethod {
  PIX
  TED
  CARD
  CASH
  BOLETO
  TRANSFER
  CHECK
}

model FinancialEntry {
  id         String             @id @default(cuid())
  type       FinancialEntryType
  category   String // ex: "Comissão", "Aluguel de sala", "Marketing"
  description String?
  amount     Decimal            @db.Decimal(12, 2)
  paidAmount Decimal?           @db.Decimal(12, 2)
  status     FinancialEntryStatus @default(PENDING)
  paymentMethod PaymentMethod?
  notes      String?
  attachmentUrl  String?
  attachmentName String?

  contractId String?
  contract   Contract?          @relation(fields: [contractId], references: [id])
  clientId   String?
  client     Client?            @relation(fields: [clientId], references: [id])
  realtorId  String?
  realtor    Realtor?           @relation(fields: [realtorId], references: [id])
  propertyId String?
  property   Property?          @relation(fields: [propertyId], references: [id])

  interactions FinancialEntryInteraction[]

  dueDate    DateTime
  paidAt     DateTime?
  createdAt  DateTime           @default(now())

  @@index([type, dueDate])
  @@index([status])
  @@index([realtorId])
  @@index([clientId])
  @@index([propertyId])
}

// Timeline/notas do lançamento financeiro — mesmo padrão de
// ClientInteraction/ProposalInteraction.
model FinancialEntryInteraction {
  id          String              @id @default(cuid())
  entryId     String
  entry       FinancialEntry      @relation(fields: [entryId], references: [id], onDelete: Cascade)
  userId      String
  user        User                @relation(fields: [userId], references: [id])
  type        LeadInteractionType
  description String
  createdAt   DateTime            @default(now())

  @@index([entryId])
}

enum GoalScope {
  COMPANY
  REALTOR
  CITY
}

// REVENUE: targetAmount é R$ (faturamento recebido no período).
// SALES_COUNT: targetAmount guarda a quantidade de vendas (contratos
// ativos/concluídos no período) — mesmo campo Decimal reaproveitado pra
// não duplicar coluna só por causa da unidade; a UI formata cada um do
// seu jeito.
enum GoalMetric {
  REVENUE
  SALES_COUNT
}

// month null = meta anual daquele ano. Sem @@unique: NULL não é único no
// Postgres pra combinações de realtorId/cityId nulos — duplicidade é
// evitada na camada de aplicação (poucas dezenas de metas, não escala).
model Goal {
  id           String     @id @default(cuid())
  scope        GoalScope  @default(COMPANY)
  metric       GoalMetric @default(REVENUE)
  year         Int
  month        Int?
  targetAmount Decimal    @db.Decimal(12, 2)
  realtorId    String?
  realtor      Realtor?   @relation(fields: [realtorId], references: [id])
  cityId       String?
  city         City?      @relation(fields: [cityId], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([scope, year, month])
}

// ---------------------------------------------------------------------------
// Site público / marketing
// ---------------------------------------------------------------------------

// Depoimentos de clientes exibidos na home pública — gerenciados pelo
// admin (não há formulário público de envio, evita moderação de spam).
model Testimonial {
  id        String   @id @default(cuid())
  name      String
  city      String?
  rating    Int      @default(5) // 1-5
  message   String
  photoUrl  String?
  published Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, order])
}

// Categoria administrável exibida como banner na home ("Apartamentos",
// "Sítios e Chácaras", "Locação"...) — generaliza o que antes era uma
// lista fixa no código. Cada segmento é um filtro salvo (tipo, finalidade,
// lançamento, preço mínimo, condomínio fechado); "active" controla se
// aparece no site, permitindo criar um segmento (ex: Locação) e deixá-lo
// desligado até a imobiliária decidir ativá-lo.
model Segment {
  id             String        @id @default(cuid())
  name           String
  slug           String        @unique
  active         Boolean       @default(true)
  order          Int           @default(0)
  icon           String        @default("Home") // nome de um ícone lucide-react, validado numa lista fixa no admin
  imageUrl       String?       // opcional; sem isso, o banner cai pra foto de um imóvel real que bate com o filtro
  propertyTypeId String?
  propertyType   PropertyType? @relation(fields: [propertyTypeId], references: [id])
  purpose        Purpose?
  isLaunch       Boolean       @default(false)
  gatedCommunity Boolean       @default(false)
  minPrice       Decimal?      @db.Decimal(12, 2)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([active, order])
}

enum PropertySubmissionStatus {
  NEW
  CONTACTED
  CONVERTED
  DECLINED
}

// "Quero vender meu imóvel" — captação de imóvel enviada por um visitante
// (fora do catálogo, ainda não é um Property) para divulgação gratuita.
// Fica numa fila própria de revisão; ao aceitar, a equipe usa os dados
// aqui pra criar o Property de verdade (ver convertedPropertyId).
model PropertySubmission {
  id          String                   @id @default(cuid())
  name        String
  phone       String
  email       String?
  purpose     Purpose                  @default(SALE)
  typeId      String?
  type        PropertyType?            @relation(fields: [typeId], references: [id])
  cityId      String?
  city        City?                    @relation(fields: [cityId], references: [id])
  // Texto livre em vez de neighborhoodId: o bairro do imóvel pode não
  // estar cadastrado ainda no catálogo (é um imóvel de fora, não nosso).
  neighborhoodText String?
  description String
  askingPrice Decimal?                 @db.Decimal(12, 2)
  status      PropertySubmissionStatus @default(NEW)
  notes       String?

  convertedPropertyId String?   @unique
  convertedProperty   Property? @relation(fields: [convertedPropertyId], references: [id])

  images    PropertySubmissionImage[]
  createdAt DateTime                  @default(now())
  updatedAt DateTime                  @updatedAt

  @@index([status])
}

model PropertySubmissionImage {
  id           String             @id @default(cuid())
  submissionId String
  submission   PropertySubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  url          String
  order        Int                @default(0)
  createdAt    DateTime           @default(now())

  @@index([submissionId])
}

// ---------------------------------------------------------------------------
// Sistema
// ---------------------------------------------------------------------------

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  action     String // ex: "property.publish"
  entityType String // ex: "Property"
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}

enum LeadDistributionMode {
  FIXED
  ROUND_ROBIN
}

// Configuração única do site (singleton — sempre uma única linha).
model SiteSettings {
  id          String   @id @default(cuid())
  phone       String
  whatsapp    String
  email       String
  address     String
  socialLinks Json?
  aboutText   String?
  // Texto livre (ex: "Seg a Sex, 9h às 18h") — exibido na seção de
  // Localização do site público. Texto livre em vez de estruturado
  // porque é só exibição, não há lógica de "aberto agora" alguma.
  businessHours String?

  // Imagens genéricas de marca do site público, editáveis pelo admin em
  // vez de arquivo fixo no código — não inclui fotos de corretor/imóvel,
  // que já têm seu próprio cadastro. Nula = usa o fallback padrão
  // embutido no componente (asset em public/images).
  heroImageUrl       String?
  aboutStoryImageUrl String?

  // Hoje a imobiliária só trabalha com venda — desligado por padrão.
  // Liga "Alugar" na navegação/busca/rodapé do site público sem precisar
  // de deploy quando a imobiliária passar a atender locação.
  rentalEnabled Boolean @default(false)

  // Corretor responsável por visitantes sem nenhuma referência de link,
  // quando leadDistributionMode = FIXED.
  defaultRealtorId String?
  defaultRealtor   Realtor? @relation(fields: [defaultRealtorId], references: [id])
  leadDistributionMode LeadDistributionMode @default(FIXED)
  // Cursor da fila round-robin: id do último corretor que recebeu um
  // visitante sem referência, pra saber quem é o próximo da vez.
  roundRobinLastRealtorId String?

  updatedAt   DateTime @updatedAt
}
